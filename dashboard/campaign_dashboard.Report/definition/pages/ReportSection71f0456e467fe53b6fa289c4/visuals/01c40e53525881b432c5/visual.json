        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Limits",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "20px",
                      "color": "#252423",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• The campaign data appears synthetic.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#4B5563"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Source ROI is bounded between 2 and 8, so no campaign can lose money.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#4B5563"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Revenue is derived as cost x (1 + ROI), so ROAS = 1 + ROI by construction.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#4B5563"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• CAC is estimated from clicks and conversion rate, not counted customers.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#4B5563"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "• Customer age is as of 2014, when the data was collected.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#4B5563"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
