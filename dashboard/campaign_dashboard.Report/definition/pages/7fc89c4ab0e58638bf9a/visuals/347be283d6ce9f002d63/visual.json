                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "Estimated CAC runs from $281.92 to $285.22 per conversion, a spread of 1.2%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13px",
                      "color": "#252423"
                    }
                  }
                ],
                "horizontalTextAlignment": "left",
                "listType": "bullet",
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "Source ROI is bounded at 2 to 8, so every campaign earns a ROAS between 3 and 9.",
